<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sbgc_description</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro for a 3-axis SimpleBGC-class camera gimbal, plus the TF frames
    that go with it. Primitive geometry only, so the package pulls in no mesh
    assets and can be included from any robot description.
  </description>
  <maintainer email="ymh1874@gmail.com">Yousef Hussein</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/cmu-impactlab/simplebgc32_ROS2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

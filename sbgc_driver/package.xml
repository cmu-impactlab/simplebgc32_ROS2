<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sbgc_driver</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for SimpleBGC32 (BaseCam / AlexMos) camera gimbal controllers.

    A lifecycle node that publishes joint state, IMU, battery and diagnostics,
    and accepts rate commands as control_msgs/JointJog. Every decision about
    what reaches the serial port lives in GimbalCore, which has no ROS
    dependency and is tested on its own.
  </description>
  <maintainer email="ymh1874@gmail.com">Yousef Hussein</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>generate_parameter_library</buildtool_depend>

  <depend>control_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sbgc_interfaces</depend>
  <depend>sbgc_protocol</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
